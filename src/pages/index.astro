---
import { Image } from 'astro:assets';
import { SUPPORT_EMAIL } from 'astro:env/server';
import Layout from '@/layouts/Layout.astro';
import InscripcionForm from '@/components/InscripcionForm.astro';
import { PROGRAMA, CURSOS } from '@/config/programa';
import logoHub from '@/assets/logo-hub.png';
---

<Layout
  title={`Inscripción · ${PROGRAMA.nombre}`}
  description={`Inscríbete gratis en ${PROGRAMA.nombre}: ${CURSOS.length} cursos online para emprendedores. ${PROGRAMA.organizador}.`}
>
  <main class="mx-auto max-w-2xl px-4 py-8 sm:py-12">
    <div class="mb-6 flex justify-center">
      <Image src={logoHub} alt="HUB Lo Barnechea" height={48} class="h-10 w-auto sm:h-12" loading="eager" />
    </div>

    <div class="rounded-2xl border-t-4 border-accent bg-surface p-6 shadow-sm sm:p-10">
      <h1 class="text-2xl font-extrabold sm:text-3xl">Inscripción {PROGRAMA.nombre}</h1>
      <p class="mt-2 mb-8 text-muted">
        Completa tus datos y recibirás en tu correo el acceso a los {CURSOS.length} cursos del Aula Virtual.
      </p>
      <InscripcionForm />
    </div>

    {
      SUPPORT_EMAIL && (
        <p class="mt-6 text-center text-sm text-muted">
          ¿Dudas? Escríbenos a{' '}
          <a class="font-semibold text-brand underline" href={`mailto:${SUPPORT_EMAIL}`}>
            {SUPPORT_EMAIL}
          </a>
        </p>
      )
    }
  </main>
</Layout>
